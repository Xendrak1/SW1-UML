# Copiá este archivo como server/.env y completá los valores.
# server/.env NO se sube al repositorio: lleva secretos.

# ------------------------------------------------------------------ Servidor
PORT=4000
# Origen permitido para CORS. En produccion, la URL del frontend.
CORS_ORIGIN=*
# Carpeta donde se guardan las imagenes subidas.
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------ Seguridad
# Secreto con el que se firman los tokens de sesion. NO tiene valor por defecto:
# uno escrito en el codigo equivale a no firmar, porque cualquiera que vea el
# repositorio podria emitir tokens validos. Genera el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Perilla de emergencia. Con false el servidor acepta peticiones sin token, como
# antes de existir la autenticacion. Es para destrabar una demostracion si algo
# falla, no un modo de uso: en la nube tiene que quedar en true.
AUTH_REQUIRED=true

# ---------------------------------------------------------------- Base de datos
# Postgres. Con docker-compose.yml del repositorio queda en el puerto 5433.
DATABASE_URL=postgresql://case_user:case_pass@localhost:5433/case_db

# ------------------------------------------------------------------------- IA
# local  = solo Ollama, en la maquina
# cloud  = solo OpenAI
# hybrid = intenta Ollama y, si no esta disponible, usa OpenAI (recomendado)
AI_STRATEGY=hybrid

OLLAMA_BASE_URL=http://127.0.0.1:11434
# El nombre tiene que coincidir EXACTAMENTE con el que muestra "ollama list".
OLLAMA_MODEL=qwen2.5:7b-instruct
# El modelo de vision es una descarga aparte del de texto.
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Tu propia clave. Si la dejas vacia, la estrategia hybrid funciona igual
# mientras Ollama este corriendo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

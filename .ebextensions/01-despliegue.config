# Elastic Beanstalk construye la imagen Docker EN la instancia. Cuando cambia
# una linea de la etapa del frontend, la cache de Docker se invalida desde ahi y
# hay que rehacer npm ci + tsc + vite build en una t3.micro: eso pasa del
# tiempo por defecto y EB aborta el comando ("Summary: [Successful: 0,
# TimedOut: 1]"), que es exactamente lo que tumbo el despliegue del 22/09 06:28.
#
# El despliegue anterior, el de las 06:08, habia tocado solo la etapa final del
# Dockerfile, asi que reuso la cache y termino rapido. No fue suerte ni un
# problema de la aplicacion: fue el tiempo de construccion.
option_settings:
  aws:elasticbeanstalk:command:
    Timeout: 1800

# La t3.micro tiene 1 GB de RAM y ningun espacio de intercambio. tsc y vite
# juntos pasan de ese limite y el build se arrastra o muere por falta de
# memoria. Dos GB de swap cuestan disco, no dinero.
#
# Los dos comandos son idempotentes: se corren en cada despliegue y no hacen
# nada si el archivo ya existe y ya esta activo.
commands:
  01_crear_swap:
    test: test ! -f /swapfile
    command: |
      dd if=/dev/zero of=/swapfile bs=1M count=2048
      chmod 600 /swapfile
      mkswap /swapfile
  02_activar_swap:
    test: test -z "$(swapon --show=NAME --noheadings 2>/dev/null | grep /swapfile)"
    command: swapon /swapfile
